cat("SummarizedExperiment created with", nrow(se), "genes and", ncol(se), "samples\n")
# Create QFeatures object for BRAP methods
qf <- QFeatures(list(gene = se), colData = colData)
cat("QFeatures object created with assay 'gene'\n")
qf
# Function to perform TMM normalization and voom transformation for a specific contrast
prepare_tmm_voom_data <- function(counts, sample_info, group1, group2) {
# Subset samples
keep_samples <- sample_info$Group %in% c(group1, group2)
counts_subset <- counts[, keep_samples]
info_subset <- sample_info[keep_samples, ]
# Create DGEList
dge <- DGEList(counts = counts_subset, group = info_subset$Group)
# TMM normalization
dge <- calcNormFactors(dge, method = "TMM")
# Create design matrix
design <- model.matrix(~ 0 + Group, data = info_subset)
colnames(design) <- levels(factor(info_subset$Group))
# Voom transformation
v <- voom(dge, design, plot = FALSE)
# Return both voom object and DGEList for flexibility
return(list(
voom = v,
design = design,
dge = dge,
sample_info = info_subset
))
}
# PCA plot
pca_res <- prcomp(t(assay(se)), scale. = TRUE)
pca_df <- data.frame(
PC1 = pca_res$x[, 1],
PC2 = pca_res$x[, 2],
Condition = colData(se)$condition
)
ggplot(pca_df, aes(x = PC1, y = PC2, color = Condition)) +
geom_point(size = 4) +
theme_bw() +
labs(title = "PCA of RNAseq Data (GSE47774 SEQC)",
x = paste0("PC1 (", round(summary(pca_res)$importance[2, 1] * 100, 1), "%)"),
y = paste0("PC2 (", round(summary(pca_res)$importance[2, 2] * 100, 1), "%)"))
# Get all unique conditions
conditions <- levels(colData(se)$condition)
cat("Conditions:", paste(conditions, collapse = ", "), "\n")
# Generate contrasts: A vs B, A vs D, B vs C, C vs D
contrasts_list <- list(
c("A", "B"),
c("A", "D"),
c("B", "C"),
c("C", "D")
)
contrast_names <- sapply(contrasts_list, function(x) paste(x[1], "vs", x[2]))
cat("\nTotal number of contrasts:", length(contrast_names), "\n")
cat("Contrasts:\n")
for(i in seq_along(contrast_names)) {
cat(sprintf("%2d. %s\n", i, contrast_names[i]))
}
# Get all ERCC spike-ins from the dataset
all_genes <- rowData(se)$Gene
is_ercc <- rowData(se)$is_ERCC
is_ercc
ercc_genes <- all_genes[is_ercc]
cat("Total ERCC spike-ins in dataset:", length(ercc_genes), "\n")
# Get all ERCC spike-ins from the dataset
all_genes <- rowData(se)$Gene
is_ercc <- rowData(se)$is_ERCC
ercc_genes <- all_genes[is_ercc]
cat("Total ERCC spike-ins in dataset:", length(ercc_genes), "\n")
# Define ERCC fold changes based on SEQC project documentation
# ERCC transcripts are divided into 4 groups with different fold changes between A and B
# Reference: External RNA Controls Consortium (ERCC) documentation
# Note: We determine which ERCC are truly DE based on expression differences
# Create ground truth for ERCC transcripts only
# We'll empirically determine which ERCC have FC != 1 by calculating actual fold changes
# from the data (comparing groups A vs B)
# Get sample indices for groups A and B
sample_conditions <- colData(se)$condition
samples_A <- which(sample_conditions == "A")
samples_B <- which(sample_conditions == "B")
# Calculate fold changes for ERCC spike-ins
counts_matrix <- assay(se, "counts")
ercc_indices <- which(is_ercc)
# Calculate mean expression for groups A and B
mean_A <- rowMeans(counts_matrix[ercc_indices, samples_A])
mean_B <- rowMeans(counts_matrix[ercc_indices, samples_B])
# Calculate log2 fold change
log2fc <- log2((mean_A + 1) / (mean_B + 1))
# Classify ERCC based on fold change magnitude
# FC = 1 means log2FC ≈ 0 (within a tolerance)
# We'll use a threshold to identify ERCC with FC != 1
fc_threshold <- 0.5  # log2 scale, so |log2FC| > 0.5 means FC != 1
is_de_ercc <- abs(log2fc) > fc_threshold
de_ercc_names <- ercc_genes[is_de_ercc]
non_de_ercc_names <- ercc_genes[!is_de_ercc]
# Create ground truth vector (only for ERCC transcripts)
# 1 = True DEG (ERCC with FC != 1)
# 0 = Not DEG (ERCC with FC = 1)
truth <- rep(0, length(ercc_genes))
names(truth) <- ercc_genes
truth[is_de_ercc] <- 1
cat("\n=== Ground Truth (ERCC Only) ===\n")
cat("True DEGs (ERCC with |log2FC| >", fc_threshold, "):", sum(truth == 1), "transcripts\n")
cat("Non-DEGs (ERCC with |log2FC| <=", fc_threshold, "):", sum(truth == 0), "transcripts\n")
cat("Total ERCC used for evaluation:", length(truth), "\n")
cat("\nNote: Endogenous genes are EXCLUDED from evaluation\n")
cat("      (unknown true DE status)\n")
# Load count matrix
count_data <- fread("GSE47774_SEQC_LIF_SQW.txt", data.table = FALSE)
# Set gene IDs as row names
rownames(count_data) <- count_data$TranscriptID
count_data <- count_data[, -1]
# Display dimensions
cat("Count matrix dimensions:", dim(count_data)[1], "genes x", dim(count_data)[2], "samples\n")
# Extract sample information from column names
# Format: SEQC_LIF_SQW_{Group}_{Replicate}_L{Lane}_{Barcode}_{FlowCell}_{Date}
colnames_df <- data.frame(
SampleName = colnames(count_data),
stringsAsFactors = FALSE
)
# Parse sample information
colnames_df <- colnames_df %>%
mutate(
Group = str_extract(SampleName, "(?<=SEQC_LIF_SQW_)[A-F]"),
Replicate = str_extract(SampleName, "(?<=_)[1-5](?=_L)"),
Lane = str_extract(SampleName, "(?<=_L)[0-9]+"),
FlowCell = str_extract(SampleName, "FC[0-9]")
)
# Filter to keep only groups A, B, C, D
sample_groups <- colnames_df %>%
filter(Group %in% c("A", "B", "C", "D")) %>%
mutate(BioRep = paste(Group, Replicate, sep = "_")) %>%
select(SampleName, Group, Replicate, BioRep)
# Keep only samples from groups A, B, C, D
keep_samples <- sample_groups$SampleName
count_data_filtered <- count_data[, keep_samples]
# Aggregate technical replicates (lanes) by summing counts
bio_reps <- unique(sample_groups$BioRep)
count_aggregated <- matrix(0, nrow = nrow(count_data_filtered), ncol = length(bio_reps))
rownames(count_aggregated) <- rownames(count_data_filtered)
colnames(count_aggregated) <- bio_reps
for (bio_rep in bio_reps) {
sample_cols <- sample_groups$SampleName[sample_groups$BioRep == bio_rep]
count_aggregated[, bio_rep] <- rowSums(count_data_filtered[, sample_cols])
}
# Create sample metadata
sample_info <- data.frame(
BioRep = colnames(count_aggregated),
Group = str_extract(colnames(count_aggregated), "^[A-D]"),
Replicate = str_extract(colnames(count_aggregated), "[1-5]$"),
stringsAsFactors = FALSE
)
rownames(sample_info) <- sample_info$BioRep
cat("\nAggregated data dimensions:", nrow(count_aggregated), "genes x", ncol(count_aggregated), "samples\n")
cat("\nSample distribution:\n")
print(table(sample_info$Group))
keep <- filterByExpr(
dge,
min.count = 10,
min.total.count = 15
)
dge_filtered <- dge[keep, , keep.lib.sizes = FALSE]
cat("\nGenes before filtering:", nrow(dge$counts), "\n")
cat("Genes after filtering:", nrow(dge_filtered$counts), "\n")
cat("Genes removed:", sum(!keep), "\n")
# Separate ERCC spike-ins from endogenous genes
is_ercc <- grepl("^ERCC", rownames(dge_filtered$counts))
cat("\nERCC spike-ins detected:", sum(is_ercc), "\n")
cat("Endogenous genes:", sum(!is_ercc), "\n")
# Create DGEList object for filtering
dge <- DGEList(counts = count_aggregated, group = sample_info$Group)
group <- dge$samples$group
keep <- filterByExpr(
dge,
group = group,
min.count = 50,
min.total.count = 100,
min.prop = 0.8
)
