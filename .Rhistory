batch = sample(c("A" , "B"), n_subj*2, prob = 0.5)
row.names = colnames(X))
sample(c("A" , "B"), n_subj*2, prob = 0.5)
sample(c("A" , "B"), n_subj*2, prob = 0.5, replace = T)
rep(0.5 , n_subj*2)
sample(c("A" , "B"), n_subj*2, prob = rep(0.5 , n_subj*2), replace = T)
1/n_subj*2
sample(c("A" , "B"), n_subj*2, prob = rep(1/n_subj*2 , n_subj*2), replace = T)
cd <- data.frame(time    = rep(c("pre", "post"), each = n_subj),
subject = factor(rep(paste0("S", 1:n_subj), 2)),
batch = sample(c("A" , "B"), n_subj*2, replace = T),
row.names = colnames(X))
cd
se <- SummarizedExperiment(assays = list(exprs = X), colData = cd)
LimROTS(x = se, group = "time", meta.info = c("time"), formula.str = "~ 0 + time",
niter = 10, correlation_block = NULL, model = "limma" , pairwise_contrasts = "timepost - timepre")
LimROTS(x = se, group = "time", meta.info = c("time" , "batch"),
formula.str = "~ 0 + time + batch",
niter = 10, correlation_block = NULL, model = "limma" ,
pairwise_contrasts = "timepost - timepre")
